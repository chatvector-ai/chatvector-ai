# Application environment
# Values: development | test | production
# ⚠  development and test bypass API-key authentication — never deploy with
#    APP_ENV=development or APP_ENV=test in a shared/public environment.
APP_ENV=development
# Note: /docs, /redoc, and /openapi.json are disabled when APP_ENV=production
# GET /queue/stats returns 404 when APP_ENV=production

# ── API-key authentication (issue #335) ───────────────────────────────────
# In development/test mode authentication is skipped entirely and every
# request is attributed to the DEV_TENANT_ID tenant.
#
# DEV_TENANT_ID  — tenant used by the auth bypass in development/test mode.
#                  Defaults to "dev".  On startup the backend automatically
#                  ensures this tenant row exists (no API key is created).
#                  No manual CLI bootstrap is required for local development.
# DEV_TENANT_ID=dev
#
# Production (APP_ENV=production) does NOT auto-create tenants or bypass auth.
# Bootstrap the first tenant + API key (run once per production environment):
#   python -m backend.cli create-tenant-key --tenant "My Org" --tenant-id my-org
# The raw API key (cv_live_…) is printed ONCE and never stored.  Save it
# immediately and set it in client configuration (SDK, frontend, etc.).
#
# Production clients must send:   Authorization: Bearer cv_live_<prefix>.<secret>
# ──────────────────────────────────────────────────────────────────────────

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=JSON        # TEXT (default) or JSON — use JSON for log shipping
# See backend/docs/logging-integrations.md for platform integration guides

# Upload validation
MAX_UPLOAD_SIZE_MB=10
# DOCX zip-bomb guards (defaults scale with MAX_UPLOAD_SIZE_MB when unset)
# DOCX_MAX_UNCOMPRESSED_MB=50
# DOCX_MAX_ZIP_ENTRIES=500
# DOCX_MAX_COMPRESSION_RATIO=100
# Optional `metadata` JSON field on POST /upload: flat object of string/number/boolean values
# DOCUMENT_METADATA_MAX_KEYS=20
# DOCUMENT_METADATA_MAX_BYTES=4096

# ── LLM & Embedding Providers ─────────────────────────────────────────────
# LLM and embedding providers are independent — mix freely (e.g. anthropic + voyage).
# All supported combinations are validated at startup (except APP_ENV=test).
# Provider: gemini (default), openai, ollama, or anthropic
# LLM_PROVIDER=gemini
# LLM_MODEL=                          # optional; provider picks its default
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=                    # optional; provider picks its default
# EMBEDDING_DIM=                      # required for models not listed in KNOWN_EMBEDDING_DIMS
                                      # (see services/providers/base.py). Switching providers
                                      # requires re-embedding + fresh DB

# Gemini (if LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini)
GEN_AI_KEY=your_google_ai_studio_api_key_here

# OpenAI (if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=                        # optional; for OpenAI-compatible APIs
                                           # e.g. https://openrouter.ai/api/v1

# Ollama (if LLM_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# Anthropic (if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=                        # optional; for Anthropic-compatible proxies

# Voyage AI (if EMBEDDING_PROVIDER=voyage)
# VOYAGE_API_KEY=your_voyage_api_key_here

# ── Database ──────────────────────────────────────────────────────────────
# Required in all environments. Docker Compose sets this automatically for
# local development via the postgres service. Production deployments must
# supply a real PostgreSQL/pgvector connection string.
#
# Supported hosts: local Docker, Neon, RDS, Cloud SQL, Supabase Postgres
# (connect directly via DATABASE_URL — the Supabase HTTP client is not used).
#
# Use postgresql+asyncpg:// for async runtime (recommended):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# Use postgresql+psycopg:// for sync/psycopg3 driver (e.g. one-off psql scripts):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ── Streaming ─────────────────────────────────────────────────────────────
# Enable Server-Sent Events (SSE) for /chat/stream and /documents/{id}/status/stream
# Set to true to activate real-time streaming; defaults to false for safety.
ENABLE_STREAMING=false

# ── Chunking ──────────────────────────────────────────────────────────────
# Strategy: fixed (default), paragraph, or semantic
# CHUNKING_STRATEGY=fixed
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# If using semantic chunking, ensure NLTK tokenizer is available:
# python -m nltk.downloader punkt

# ── Query Transformations ─────────────────────────────────────────────────
# QUERY_TRANSFORMATION_ENABLED=false
# QUERY_TRANSFORMATION_STRATEGY=rewrite  # rewrite | expand | stepback
# Rewrite / expand / step-back stay off unless enabled here or per request.
# HISTORY_AWARE_RETRIEVAL_DEFAULT=true   # gated follow-up resolution; false resolves only when query transformation is enabled
# QUERY_TRANSFORMATION_HISTORY_WINDOW=6  # messages used to resolve a follow-up
# GENERATION_HISTORY_WINDOW=10           # messages injected into answer context
# MAX_SESSION_HISTORY_MESSAGES=20        # default history load floor; request windows 0–100 are honored up to 100

# ── Context window ────────────────────────────────────────────────────────
# MAX_CONTEXT_CHARS=32000             # max chars of retrieved context sent to LLM; drops whole chunks

# ── LLM / Prompt ──────────────────────────────────────────────────────────
# PROMPT_PERSONA=default              # default | concise | conversational | academic | technical
# `default` is the reference-demo persona (matches the code default; docker-compose.yml pins it too).
# A deployment may set any of the values above instead.
# Path to system prompt file (overrides PROMPT_PERSONA if set)
# SYSTEM_PROMPT_PATH=
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_HTTP_TIMEOUT_MS=60000           # LLM HTTP client (ms); Gemini, OpenAI, Ollama generate
# EMBEDDING_HTTP_TIMEOUT_SEC=60       # Per-attempt timeout for embedding calls + OpenAI embed client
# EMBEDDING_HEALTH_CHECK_TIMEOUT_SEC=10  # /status embedding sub-probe (seconds)
# LLM_HEALTH_CHECK_TIMEOUT_SEC=10    # /status LLM probe timeout (seconds)
#
# Optional Redis embedding cache (default off). Failures fall through to the provider.
# ENABLE_EMBEDDING_CACHE=false
# EMBEDDING_CACHE_KEY_PREFIX=chatvector:embedcache
# EMBEDDING_CACHE_TTL_SECONDS=0       # 0 means no expiry
# EMBEDDING_CACHE_INCLUDE_TENANT=false  # fold tenant_id into the cache key
# EMBEDDING_CACHE_REDIS_TIMEOUT_SEC=0.25  # cache Redis GET/SET only; not REDIS_SOCKET_TIMEOUT_SEC

# ── Queue backend ─────────────────────────────────────────────────────────
# Memory queue is enabled by default in development. 
# For production (APP_ENV=production), Redis is the default.
# QUEUE_BACKEND=memory                # memory or redis
# REDIS_URL=redis://localhost:6379/0
# REDIS_SOCKET_TIMEOUT_SEC=5          # socket + connect timeout for queue and idempotency Redis clients
#
# Horizontal API replicas (more than one API container; still --workers 1 each).
# MULTI_API_INSTANCE=false            # true requires QUEUE_BACKEND=redis and ARTIFACT_STORAGE=s3
# TENANT_REGISTRY_DISABLED=           # defaults to true when MULTI_API_INSTANCE=true
# STALE_RECONCILE_LOCK_TTL_SECONDS=600  # Redis lock so only one replica fails stale docs

# ── Background ingestion queue ────────────────────────────────────────────
# QUEUE_WORKER_COUNT=3                # clamped to 1–5
# QUEUE_MAX_SIZE=100                  # max jobs waiting; over capacity → 503 on upload
# QUEUE_EMBEDDING_RPS=2.0             # max embedding HTTP batches/sec per API process
# QUEUE_SPILL_DIR=/tmp/chatvector       # local ArtifactStorage root for Redis uploads
# ARTIFACT_STORAGE=local                # local (default) or s3
# ARTIFACT_TTL_SECONDS=86400            # S3 object expiry mark; 0 disables TTL metadata
# ARTIFACT_S3_BUCKET=                   # required when ARTIFACT_STORAGE=s3
# ARTIFACT_S3_ENDPOINT_URL=             # MinIO / custom S3 endpoint
# ARTIFACT_S3_REGION=us-east-1
# ARTIFACT_S3_ACCESS_KEY=               # or AWS_ACCESS_KEY_ID (IAM role also works)
# ARTIFACT_S3_SECRET_KEY=               # or AWS_SECRET_ACCESS_KEY
# ARTIFACT_S3_PREFIX=chatvector/artifacts/
# ARTIFACT_S3_FORCE_PATH_STYLE=true     # typical for MinIO
# QUEUE_DLQ_MAX_ENTRIES=1000            # max dead-letter records retained
# QUEUE_JOB_MAX_RETRIES=3
# QUEUE_RETRY_BASE_DELAY=2.0          # base seconds for exponential backoff between retries

# ── Ingestion completion webhooks (v1, env-only) ───────────────────────────
# WEBHOOK_ENABLED=false
# WEBHOOK_URL=https://your-service.example/webhooks/ingestion
# WEBHOOK_SECRET=shared_hmac_secret
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_TIMEOUT_SECONDS=10
# See DEVELOPMENT.md (Ingestion completion webhooks) for payload, signature, and dedupe.

# ── Retrieval & chat limits ────────────────────────────────────────────────
# ENABLE_RERANKING=false              # reorder retrieved chunks before context assembly
# RERANKER_PROVIDER=similarity        # similarity or cohere; unknown names fail at startup
# COHERE_API_KEY=                     # required when RERANKER_PROVIDER=cohere; process env only
# COHERE_RERANK_MODEL=rerank-v3.5     # Cohere rerank model
# COHERE_RERANK_URL=https://api.cohere.com/v2/rerank
# RERANKER_TIMEOUT_SEC=5              # hard timeout on hosted reranker calls; failure falls back to retrieval order
# RERANKER_MAX_CANDIDATES=50          # max chunks sent to a hosted reranker per request
# HYBRID_RETRIEVAL_ENABLED=false      # fuse pgvector + PostgreSQL full-text (SQLAlchemy only)
# ENABLE_GRAPH_RETRIEVAL=false        # experimental GraphRAG overlay; default off, no extra deps
# GRAPH_RETRIEVAL_FIXTURE_PATH=       # optional JSON entity-chunk graph for the fixture prototype
# RETRIEVAL_PRESETS_PATH=             # optional JSON file: {"eval_hybrid": {"hybrid_enabled": true, ...}}
# RETRIEVAL_PRESETS=                  # optional inline JSON with the same shape (merged after file)
# RETRIEVAL_MAX_CONCURRENCY=8         # max concurrent vector searches (chat retrieval)
# SQLALCHEMY_RETRIEVAL_CONCURRENCY=8  # max concurrent DB sessions for pgvector search
# CHAT_BATCH_MAX_ITEMS=20             # max queries per POST /chat/batch
# CHAT_BATCH_LLM_CONCURRENCY=4       # max concurrent batch transform/answer LLM work per API process
# CHAT_MAX_DOC_IDS_PER_QUERY=10       # max document IDs per batch item

# ── SQLAlchemy / PostgreSQL ───────────────────────────────────────────────
# SQLALCHEMY_POOL_SIZE=5
# SQLALCHEMY_MAX_OVERFLOW=10
# SQLALCHEMY_POOL_TIMEOUT_SEC=30
# SQLALCHEMY_STATEMENT_TIMEOUT_SEC=30 # asyncpg command_timeout (seconds)

# ── Idempotency (Idempotency-Key header on POST /upload and POST /sessions) ─
# IDEMPOTENCY_KEY_PREFIX=chatvector:idempotency
# IDEMPOTENCY_TTL_SECONDS=86400
# IDEMPOTENCY_KEY_MAX_LENGTH=255
# IDEMPOTENCY_WAIT_TIMEOUT_SECONDS=30
# IDEMPOTENCY_POLL_INTERVAL_SECONDS=0.05

# ── Health checks ─────────────────────────────────────────────────────────
# HEALTH_CHECK_CACHE_TTL_SECONDS=60   # 0 = always re-run checks

# ── CORS ──────────────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000
# Note: wildcard (*) is not valid with allow_credentials=True
# Use comma-separated explicit origins for multiple allowed origins

# ── Rate Limiting ─────────────────────────────────────────────────────────
# Per-tenant request limits (falls back to per-IP only when
# RATE_LIMIT_DEV_IP_FALLBACK=true in development/test with no tenant).
# Format: "N/period" (minute, hour, day)
# RATE_LIMIT_DEV_IP_FALLBACK=false
# RATE_LIMIT_UPLOAD=20/hour
# RATE_LIMIT_CHAT=30/minute
# RATE_LIMIT_CHAT_BATCH=10/minute
# RATE_LIMIT_STATUS=10/minute
# RATE_LIMIT_QUEUE_STATS=10/minute
# RATE_LIMIT_DOCUMENT_STATUS=120/minute
# RATE_LIMIT_DOCUMENT_DELETE=60/hour
# RATE_LIMIT_FEEDBACK=60/minute
